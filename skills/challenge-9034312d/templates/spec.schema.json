{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "apparatus-route-spec.schema.json",
  "title": "Apparatus / technical-route figure spec",
  "description": "Intermediate representation written by the agent from real input materials. run_case.py normalizes it and svg_gen.py renders it. Every component, stage, connection, condition and decision carries its own source.",
  "type": "object",
  "properties": {
    "figure_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "apparatus",
        "route",
        "both"
      ]
    },
    "title": {
      "type": "string"
    },
    "width_mm": {
      "type": "number",
      "minimum": 60,
      "maximum": 420
    },
    "height_mm": {
      "type": "number",
      "minimum": 45,
      "maximum": 600
    },
    "font_family": {
      "type": "string"
    },
    "font_size_pt": {
      "type": "number",
      "minimum": 6,
      "maximum": 16
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/definitions/panel"
      }
    },
    "nodes": {
      "$ref": "#/definitions/nodes"
    },
    "edges": {
      "$ref": "#/definitions/edges"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/component"
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/connection"
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/stage"
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/condition"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/decision"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "legend": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "panels"
      ]
    },
    {
      "required": [
        "nodes"
      ]
    },
    {
      "required": [
        "components"
      ]
    },
    {
      "required": [
        "stages"
      ]
    }
  ],
  "definitions": {
    "source": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "locator": {
              "type": "string"
            },
            "quote": {
              "type": "string"
            }
          },
          "anyOf": [
            {
              "required": [
                "path"
              ]
            },
            {
              "required": [
                "locator"
              ]
            }
          ]
        }
      ]
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "sublabel": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "shape": {
          "enum": [
            "rect",
            "rounded",
            "ellipse",
            "circle",
            "hexagon",
            "diamond"
          ]
        },
        "rank": {
          "type": "integer",
          "minimum": 0
        },
        "order": {
          "type": "number"
        },
        "fill": {
          "type": "string"
        },
        "dashed": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/definitions/source"
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/node"
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "flow",
            "signal",
            "yes",
            "no",
            "loop",
            "inferred",
            "default",
            "activate",
            "inhibit",
            "bind"
          ]
        },
        "label": {
          "type": "string"
        },
        "medium": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "forward",
            "reverse",
            "undetermined"
          ]
        },
        "from_port": {
          "type": "string"
        },
        "to_port": {
          "type": "string"
        },
        "route": {
          "enum": [
            "straight",
            "orthogonal",
            "curve"
          ]
        },
        "dashed": {
          "type": "boolean"
        },
        "feedback": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/definitions/source"
        },
        "show_ports": {
          "type": "boolean"
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/edge"
      }
    },
    "component": {
      "type": "object",
      "required": [
        "id",
        "label",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "sublabel": {
          "type": "string"
        },
        "shape": {
          "type": "string"
        },
        "source": {
          "$ref": "#/definitions/source"
        }
      }
    },
    "connection": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "medium",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "medium": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "forward",
            "reverse",
            "undetermined"
          ]
        },
        "from_port": {
          "type": "string"
        },
        "to_port": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "feedback": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/definitions/source"
        },
        "show_ports": {
          "type": "boolean"
        }
      }
    },
    "stage": {
      "type": "object",
      "required": [
        "id",
        "label",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "enum": [
            "stage",
            "terminal",
            "milestone"
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "type": "string"
        },
        "order": {
          "type": "number"
        },
        "source": {
          "$ref": "#/definitions/source"
        }
      }
    },
    "condition": {
      "type": "object",
      "required": [
        "id",
        "location",
        "params",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "params": {
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "string"
            }
          ]
        },
        "source": {
          "$ref": "#/definitions/source"
        }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "id",
        "question",
        "yes",
        "no",
        "criterion_source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "after": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "yes": {
          "type": "string"
        },
        "no": {
          "type": "string"
        },
        "criterion": {
          "type": "string"
        },
        "criterion_source": {
          "oneOf": [
            {
              "$ref": "#/definitions/source"
            },
            {
              "enum": [
                "not_provided",
                "not provided"
              ]
            }
          ]
        }
      }
    },
    "panel": {
      "type": "object",
      "anyOf": [
        {
          "required": [
            "nodes"
          ]
        },
        {
          "required": [
            "components"
          ]
        },
        {
          "required": [
            "stages"
          ]
        }
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "apparatus",
            "route"
          ]
        },
        "title": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "LR",
            "TB"
          ]
        },
        "layout": {
          "enum": [
            "layered",
            "free",
            "grid"
          ]
        },
        "nodes": {
          "$ref": "#/definitions/nodes"
        },
        "edges": {
          "$ref": "#/definitions/edges"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/component"
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/connection"
          }
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/stage"
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/condition"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/decision"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "legend": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "footnote": {
          "type": "string"
        }
      }
    }
  }
}
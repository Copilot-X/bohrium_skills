{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "科研数据清洗与处理 work file",
  "type": "object",
  "required": [
    "case_id",
    "mode",
    "summary",
    "cleaned_table",
    "cleaning_rules",
    "quality_report",
    "rule_log",
    "original_snapshot",
    "closure",
    "data_dictionary",
    "evidence"
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "mode": {"const": "data-cleaning"},
    "summary": {"type": "string", "minLength": 1},
    "analysis": {
      "type": "object",
      "required": ["question", "method"],
      "properties": {
        "question": {"type": "string"},
        "method": {"type": "string"},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "steps": {"type": "array", "items": {"type": "string"}}
      }
    },
    "data_dictionary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["column", "description", "source", "locator"],
        "properties": {
          "column": {"type": "string"},
          "description": {"type": "string"},
          "source": {"type": "string"},
          "locator": {"type": "string", "pattern": "^L[0-9]+$"}
        }
      }
    },
    "cleaning_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "rule", "field", "before", "after", "delta", "reversible"],
        "properties": {
          "id": {"type": "string"},
          "rule": {"type": "string"},
          "field": {"type": "string"},
          "before": {"type": "integer", "minimum": 0},
          "after": {"type": "integer", "minimum": 0},
          "delta": {"type": "integer"},
          "basis": {"type": "string"},
          "reversible": {"type": "boolean"}
        }
      }
    },
    "quality_report": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["field", "issue", "count", "action"],
        "properties": {
          "field": {"type": "string"},
          "issue": {"type": "string"},
          "count": {"type": "integer", "minimum": 0},
          "action": {"type": "string", "minLength": 1}
        }
      }
    },
    "closure": {
      "type": "object",
      "required": ["raw_rows", "dropped", "cleaned_rows", "closed"],
      "properties": {
        "raw_rows": {"type": "integer", "minimum": 0},
        "dropped": {"type": "integer", "minimum": 0},
        "cleaned_rows": {"type": "integer", "minimum": 0},
        "closed": {"const": true}
      }
    },
    "counts": {"type": "object"},
    "stats": {"type": "object"},
    "cleaned_table": {"type": "string", "pattern": "^output/"},
    "original_snapshot": {"type": "string", "pattern": "^output/"},
    "rule_log": {"type": "string", "pattern": "^output/"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "locator", "quote"],
        "properties": {
          "path": {"type": "string"},
          "locator": {"type": "string", "pattern": "^L[0-9]+$"},
          "quote": {"type": "string", "minLength": 1}
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "metric", "value", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "metric": {"type": "string"},
          "value": {"type": ["number", "string"]},
          "unit": {"type": "string"},
          "evidence": {
            "type": "object",
            "required": ["path", "locator", "quote"],
            "properties": {
              "path": {"type": "string"},
              "locator": {"type": "string"},
              "quote": {"type": "string"}
            }
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "reason"],
        "properties": {
          "item": {"type": "string"},
          "reason": {"type": "string"},
          "impact": {"type": "string"},
          "action": {"type": "string"}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "多步骤数据分析 Agent work file",
  "type": "object",
  "required": [
    "case_id",
    "summary",
    "steps",
    "results",
    "evidence"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "description": "task-specific field"
    },
    "mode": {
      "type": "string",
      "description": "task-specific field"
    },
    "summary": {
      "type": "string",
      "description": "task-specific field"
    },
    "analysis": {
      "type": "object",
      "description": "问题、方法、假设与步骤"
    },
    "results": {
      "type": "array",
      "description": "指标、数值、单位、来源与证据",
      "items": {
        "type": "object"
      }
    },
    "figures": {
      "type": "array",
      "description": "图表路径及其数据来源",
      "items": {
        "type": "object"
      }
    },
    "code": {
      "type": "string",
      "description": "真实执行的分析脚本路径"
    },
    "evidence": {
      "type": "array",
      "description": "path+locator+quote 的逐字证据",
      "items": {
        "type": "object"
      }
    },
    "uncertainties": {
      "type": "array",
      "description": "异常、缺失、失败与未验证项",
      "items": {
        "type": "object"
      }
    },
    "steps": {
      "type": "array",
      "description": "task-specific field required by this sub-challenge",
      "items": {
        "type": "object"
      }
    },
    "tool_calls": {
      "type": "array",
      "description": "task-specific field required by this sub-challenge",
      "items": {
        "type": "object"
      }
    },
    "intermediate_results": {
      "type": "array",
      "description": "task-specific field required by this sub-challenge",
      "items": {
        "type": "object"
      }
    },
    "recovery": {
      "type": "array",
      "description": "task-specific field required by this sub-challenge",
      "items": {
        "type": "object"
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pathway-spec.schema.json",
  "title": "Source-bound pathway ledger",
  "description": "Model-authored semantic ledger consumed by scripts/run_case.py. Every element that appears in the figure must have an id, a label and a source or an explicit inferred kind.",
  "type": "object",
  "required": ["case_id", "compartments", "molecules", "interactions"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "figure_id": {"type": "string"},
    "title": {"type": "string"},
    "workorder": {"type": "string", "default": "biological_mechanism_pathway"},
    "canvas": {
      "type": "object",
      "properties": {
        "width_mm": {"type": "number", "minimum": 80, "maximum": 400},
        "height_mm": {"type": "number", "minimum": 50, "maximum": 400},
        "direction": {"type": "string", "enum": ["LR", "TB"], "default": "LR"},
        "font_family": {"type": "string"},
        "font_size_pt": {"type": "number", "minimum": 7, "maximum": 14}
      },
      "additionalProperties": true
    },
    "naming": {
      "type": "object",
      "properties": {
        "gene_style": {"type": "string", "enum": ["italic", "roman"]},
        "protein_style": {"type": "string", "enum": ["roman", "italic"]},
        "alias_policy": {"type": "string"},
        "complex_policy": {"type": "string"}
      },
      "additionalProperties": true
    },
    "compartments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 0},
          "fill": {"type": "string"},
          "stroke": {"type": "string"},
          "dashed": {"type": "boolean"},
          "source": {"$ref": "#/$defs/source"}
        },
        "additionalProperties": true
      }
    },
    "molecules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "compartment"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "symbol": {"type": "string"},
          "entity_kind": {
            "type": "string",
            "enum": ["gene", "protein", "complex", "cell", "metabolite", "rna"]
          },
          "type": {
            "type": "string",
            "enum": ["ligand", "receptor", "kinase", "phosphatase", "gtpase",
                     "tf", "complex", "metabolite", "gene", "rna", "channel",
                     "cell", "protein", "other"]
          },
          "compartment": {"type": "string", "minLength": 1},
          "rank": {"type": "integer", "minimum": 0},
          "order": {"type": "integer", "minimum": 0},
          "sublabel": {"type": "string"},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "italic": {"type": "boolean"},
          "dashed": {"type": "boolean"},
          "fill": {"type": "string"},
          "stroke": {"type": "string"},
          "max_text_px": {"type": "number"},
          "source": {"$ref": "#/$defs/source"}
        },
        "additionalProperties": true
      }
    },
    "interactions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "effect"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "effect": {
            "type": "string",
            "enum": ["activate", "inhibit", "bind", "translocate", "modify",
                     "association", "unknown_link", "inferred"]
          },
          "base_effect": {
            "type": "string",
            "enum": ["activate", "inhibit", "bind", "translocate", "modify",
                     "association", "unknown_link"]
          },
          "kind": {"type": "string", "enum": ["reported", "inferred"]},
          "mechanism": {"type": "string"},
          "label": {"type": "string"},
          "route": {"type": "string", "enum": ["straight", "curve", "orthogonal"]},
          "direction": {"type": "string", "enum": ["forward", "reverse", "both"]},
          "evidence_strength": {
            "type": "string",
            "enum": ["strong", "moderate", "weak", "speculative"]
          },
          "source": {"$ref": "#/$defs/source"}
        },
        "additionalProperties": true
      }
    },
    "legend": {
      "type": "object",
      "properties": {
        "edge_semantics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "effect": {"type": "string"},
              "label": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "encodings": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": true
    },
    "data_encoding": {"type": "array", "items": {"type": "object"}},
    "omitted": {"type": "array", "items": {"type": "object"}},
    "conflicts": {"type": "array", "items": {"type": "object"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "disclaimers": {"type": "array", "items": {"type": "string"}},
    "caption": {"type": "string"},
    "alt_text": {"type": "string"},
    "footnote": {"type": "string"}
  },
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "locator": {"type": "string"},
        "quote": {"type": "string"}
      },
      "required": ["path"],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "文献研究质量评价 work file",
  "type": "object",
  "required": [
    "case_id",
    "summary",
    "appraisals",
    "evidence"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "description": "task-specific field"
    },
    "mode": {
      "type": "string",
      "description": "task-specific field"
    },
    "summary": {
      "type": "string",
      "description": "task-specific field required by this sub-challenge"
    },
    "question": {
      "type": "string",
      "description": "task-specific field"
    },
    "queries": {
      "type": "array",
      "description": "检索式、来源与目的；每条可复跑",
      "items": {
        "type": "object"
      }
    },
    "candidates": {
      "type": "array",
      "description": "候选记录：title/authors/year/venue/doi/relevance/reason/evidence",
      "items": {
        "type": "object"
      }
    },
    "metrics": {
      "type": "object",
      "description": "k、Precision@k、nDCG@k、Recall@k、元数据准确率及计算口径"
    },
    "screening": {
      "type": "object",
      "description": "include/exclude/uncertain 分层与判据"
    },
    "findings": {
      "type": "array",
      "description": "关键发现及证据",
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array",
      "description": "path+locator+quote 的逐字证据",
      "items": {
        "type": "object"
      }
    },
    "uncertainties": {
      "type": "array",
      "description": "空结果、冲突、权限、缺失元数据",
      "items": {
        "type": "object"
      }
    },
    "dimensions": {
      "type": "array",
      "description": "task-specific field required by this sub-challenge",
      "items": {
        "type": "object"
      }
    },
    "appraisals": {
      "type": "array",
      "description": "task-specific field required by this sub-challenge",
      "items": {
        "type": "object"
      }
    },
    "risk_of_bias": {
      "type": "object",
      "description": "task-specific field required by this sub-challenge"
    }
  }
}

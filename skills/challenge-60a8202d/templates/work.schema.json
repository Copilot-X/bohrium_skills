{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "引文追踪与关联文献发现 work file",
  "type": "object",
  "required": [
    "case_id",
    "summary",
    "queries",
    "candidates",
    "tracking_scope",
    "seeds",
    "edges",
    "paths",
    "identity_groups",
    "related_works",
    "direction_unknown",
    "evidence"
  ],
  "properties": {
    "case_id": {"type": "string"},
    "mode": {"const": "citation-tracking"},
    "summary": {"type": "string", "minLength": 40},
    "question": {"type": "string"},
    "queries": {
      "type": "array",
      "minItems": 1,
      "description": "supplied_export 时写 provenance；禁止编造在线查询",
      "items": {
        "type": "object",
        "required": ["id", "type", "source", "purpose"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["live_search", "supplied_export", "provided_citation_graph"]},
          "query": {"type": "string"},
          "source": {"type": "string"},
          "purpose": {"type": "string"}
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "description": "全部记录；与输入元数据逐字段一致",
      "items": {
        "type": "object",
        "required": ["id", "title", "authors", "year", "venue", "doi",
                     "relevance", "reason", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "authors": {"type": "string"},
          "year": {"type": ["integer", "string"]},
          "venue": {"type": "string"},
          "doi": {"type": "string"},
          "relevance": {"enum": ["seed", "reference", "follow_up", "parallel", "unresolved"]},
          "rank": {"type": ["integer", "null"]},
          "score": {"type": ["number", "null"]},
          "dedupe_key": {"type": "string"},
          "merged_from": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": "string", "minLength": 8},
          "evidence": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "tracking_scope": {
      "type": "object",
      "required": ["levels", "stop_condition", "sources"],
      "properties": {
        "levels": {"type": "integer", "minimum": 1},
        "stop_condition": {"type": "string", "minLength": 8},
        "budget": {"type": "string"},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "doi", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "authors": {"type": "string"},
          "year": {"type": ["integer", "string"]},
          "venue": {"type": "string"},
          "doi": {"type": "string"},
          "evidence": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "edges": {
      "type": "array",
      "description": "direction=forward: to 引用 from；backward: from 引用 to",
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "direction", "hop", "source", "basis"],
        "properties": {
          "id": {"type": "string"},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "direction": {"enum": ["forward", "backward"]},
          "hop": {"type": "integer", "minimum": 1},
          "basis": {"type": "string", "minLength": 8},
          "source": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "paths": {
      "type": "array",
      "description": "nodes[i] -> nodes[i+1] 必须是 edges[i] 的 from->to",
      "items": {
        "type": "object",
        "required": ["id", "nodes", "edges", "relation", "direct"],
        "properties": {
          "id": {"type": "string"},
          "nodes": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "edges": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "relation": {"enum": ["cites", "cited_by", "mixed"]},
          "direct": {"type": "boolean"},
          "basis": {"type": "string"}
        }
      }
    },
    "identity_groups": {
      "type": "array",
      "minItems": 1,
      "description": "每个输入记录恰好出现在一个组；同标题同作者版本合并",
      "items": {
        "type": "object",
        "required": ["canonical_id", "members", "merged", "basis"],
        "properties": {
          "canonical_id": {"type": "string"},
          "members": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "merged": {"type": "boolean"},
          "basis": {"type": "string", "minLength": 8},
          "version_basis": {"type": "string"},
          "keep_separate_reason": {"type": "string"}
        }
      }
    },
    "related_works": {
      "type": "array",
      "minItems": 1,
      "description": "共被引/文献耦合/共享数据等；不是引用边",
      "items": {
        "type": "object",
        "required": ["id", "relation", "basis", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "relation": {
            "enum": ["bibliographic_coupling", "co_citation", "shared_dataset",
                     "shared_author", "topic", "method_lineage"]
          },
          "basis": {"type": "string", "minLength": 8},
          "evidence": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "direction_unknown": {
      "type": "object",
      "required": ["checked", "items", "policy"],
      "description": "方向不明记录；不得进入有向 paths",
      "properties": {
        "checked": {"type": "boolean"},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "reason", "source"],
            "properties": {
              "id": {"type": "string"},
              "ids": {"type": "array", "items": {"type": "string"}},
              "reason": {"type": "string", "minLength": 8},
              "source": {"type": "string"}
            }
          }
        },
        "policy": {"type": "string", "minLength": 8}
      }
    },
    "findings": {"type": "array", "items": {"type": "object"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "uncertainties": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["path", "locator", "quote"],
      "properties": {
        "path": {"type": "string"},
        "locator": {"type": "string"},
        "quote": {"type": "string", "minLength": 8}
      }
    }
  }
}

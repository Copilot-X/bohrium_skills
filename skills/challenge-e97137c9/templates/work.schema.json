{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "文献综述生成 work file",
  "type": "object",
  "required": [
    "case_id",
    "summary",
    "screening_criteria",
    "screening_log",
    "themes",
    "gaps",
    "findings",
    "evidence"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "description": "task-specific field"
    },
    "mode": {
      "type": "string",
      "description": "task-specific field"
    },
    "summary": {
      "type": "string",
      "description": "task-specific field"
    },
    "question": {
      "type": "string",
      "description": "研究问题与范围"
    },
    "findings": {
      "type": "array",
      "description": "task-specific field required by this sub-challenge",
      "items": {
        "type": "object"
      }
    },
    "references": {
      "type": "array",
      "description": "引用条目与标识符",
      "items": {
        "type": "object"
      }
    },
    "gap_analysis": {
      "type": "array",
      "description": "研究空白及其证据基础",
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array",
      "description": "path+locator+quote 的逐字证据",
      "items": {
        "type": "object"
      }
    },
    "uncertainties": {
      "type": "array",
      "description": "冲突、空白、未覆盖范围",
      "items": {
        "type": "object"
      }
    },
    "screening_criteria": {
      "type": "object",
      "description": "task-specific field required by this sub-challenge"
    },
    "screening_log": {
      "type": "array",
      "description": "task-specific field required by this sub-challenge",
      "items": {
        "type": "object"
      }
    },
    "themes": {
      "type": "array",
      "description": "task-specific field required by this sub-challenge",
      "items": {
        "type": "object"
      }
    },
    "gaps": {
      "type": "array",
      "description": "task-specific field required by this sub-challenge",
      "items": {
        "type": "object"
      }
    }
  }
}

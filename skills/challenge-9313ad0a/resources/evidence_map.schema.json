{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/mindmap-builder/evidence_map.schema.json",
  "title": "Mind-map evidence map (result.evidence_map)",
  "description": "Key claims/nodes mapped to a real source path, locator and verbatim quote. The same object is written by extract_material.py into work/material.json and by make_result.py into output/result.json.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["claim_id", "claim", "source"],
    "properties": {
      "claim_id": {"type": "string", "minLength": 1},
      "claim": {"type": "string", "minLength": 1, "maxLength": 300},
      "node_type": {
        "type": "string",
        "enum": ["topic", "concept", "question", "method", "evidence", "result", "claim", "risk", "gap", "task"]
      },
      "kind": {"type": "string", "enum": ["reported", "task", "inferred"]},
      "source": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "locator": {"type": "string"},
          "quote": {"type": "string", "minLength": 1, "maxLength": 600}
        },
        "additionalProperties": false
      },
      "confidence": {"type": "string", "enum": ["high", "medium", "low"]}
    },
    "additionalProperties": true
  }
}

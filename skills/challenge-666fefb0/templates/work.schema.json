{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "文献与资料自动分类 work file",
  "type": "object",
  "required": [
    "case_id",
    "summary",
    "taxonomy",
    "items",
    "evidence"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "description": "task-specific field"
    },
    "mode": {
      "type": "string",
      "description": "task-specific field"
    },
    "summary": {
      "type": "string",
      "description": "task-specific field"
    },
    "items": {
      "type": "array",
      "description": "task-specific field required by this sub-challenge",
      "items": {
        "type": "object"
      }
    },
    "operations": {
      "type": "array",
      "description": "task-specific field required by this sub-challenge",
      "items": {
        "type": "object"
      }
    },
    "findings": {
      "type": "array",
      "description": "检索/问答/批注结论及证据",
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array",
      "description": "path+locator+quote 的逐字证据",
      "items": {
        "type": "object"
      }
    },
    "uncertainties": {
      "type": "array",
      "description": "权限、损坏、跳过、冲突",
      "items": {
        "type": "object"
      }
    },
    "taxonomy": {
      "type": "object",
      "description": "task-specific field required by this sub-challenge"
    },
    "review_queue": {
      "type": "array",
      "description": "task-specific field required by this sub-challenge",
      "items": {
        "type": "object"
      }
    },
    "duplicate_groups": {
      "type": "array",
      "description": "task-specific field required by this sub-challenge",
      "items": {
        "type": "object"
      }
    },
    "version_groups": {
      "type": "array",
      "description": "task-specific field required by this sub-challenge",
      "items": {
        "type": "object"
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "实验方案可行性评估 work file",
  "type": "object",
  "required": [
    "case_id",
    "summary",
    "feasibility",
    "risks",
    "evidence",
    "conditions",
    "confirmation_items"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "description": "task-specific field"
    },
    "mode": {
      "type": "string",
      "description": "task-specific field"
    },
    "summary": {
      "type": "string",
      "description": "task-specific field"
    },
    "hypothesis": {
      "type": "string",
      "description": "可检验假设"
    },
    "variables": {
      "type": "object",
      "description": "自变量、因变量、对照"
    },
    "steps": {
      "type": "array",
      "description": "可执行步骤、参数、时长与材料",
      "items": {
        "type": "object"
      }
    },
    "parameters": {
      "type": "array",
      "description": "参数值、单位与依据",
      "items": {
        "type": "object"
      }
    },
    "risks": {
      "type": "array",
      "description": "task-specific field required by this sub-challenge",
      "items": {
        "type": "object"
      }
    },
    "confirmation_items": {
      "type": "array",
      "description": "设备/材料/安全/伦理/专家确认项",
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array",
      "description": "path+locator+quote 的逐字证据",
      "items": {
        "type": "object"
      }
    },
    "uncertainties": {
      "type": "array",
      "description": "未确认、冲突、缺口",
      "items": {
        "type": "object"
      }
    },
    "feasibility": {
      "type": "object",
      "description": "task-specific field required by this sub-challenge"
    },
    "conditions": {
      "type": "array",
      "description": "可执行的关闭条件",
      "items": {
        "type": "object"
      }
    }
  }
}

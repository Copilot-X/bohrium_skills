{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Structured document (work/document.json -> document)",
  "type": "object",
  "required": ["case_id", "document", "report"],
  "properties": {
    "case_id": {"type": "string"},
    "document": {
      "type": "object",
      "required": ["source_path", "title", "authors", "abstract", "page_count",
                   "readable_pages", "ocr_pages", "empty_pages", "sections",
                   "tables", "figures", "equations", "references"],
      "properties": {
        "case_id": {"type": "string"},
        "source_path": {"type": "string"},
        "title": {"type": "string", "minLength": 1},
        "authors": {"type": "array", "items": {"type": "string"}},
        "abstract": {"type": "string"},
        "page_count": {"type": "integer", "minimum": 0},
        "readable_pages": {"type": "integer", "minimum": 0},
        "ocr_pages": {"type": "array", "items": {"type": "integer"}},
        "empty_pages": {"type": "array", "items": {"type": "integer"}},
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "heading", "level", "paragraphs"],
            "properties": {
              "id": {"type": "string", "pattern": "^S[0-9]+$"},
              "heading": {"type": "string"},
              "level": {"type": "integer", "minimum": 0},
              "paragraphs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "text", "page", "block_id", "locator"],
                  "properties": {
                    "id": {"type": "string", "pattern": "^P[0-9]+$"},
                    "text": {"type": "string", "minLength": 1},
                    "page": {"type": ["integer", "null"]},
                    "block_id": {"type": ["integer", "string", "null"]},
                    "bbox": {"type": ["array", "null"]},
                    "locator": {"type": "string", "minLength": 1},
                    "kind": {"type": "string"}
                  }
                }
              }
            }
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "columns", "rows", "source_locator"],
            "properties": {
              "id": {"type": "string", "pattern": "^T[0-9]+$"},
              "page": {"type": ["integer", "null"]},
              "caption": {"type": "string"},
              "columns": {"type": "array", "items": {"type": "string"}},
              "rows": {
                "type": "array",
                "items": {"type": "array", "items": {"type": "string"}}
              },
              "source_locator": {"type": "string", "minLength": 1},
              "detection": {"type": "string"}
            }
          }
        },
        "figures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "caption", "page", "locator"],
            "properties": {
              "id": {"type": "string", "pattern": "^F[0-9]+$"},
              "label": {"type": "string"},
              "caption": {"type": "string", "minLength": 1},
              "page": {"type": ["integer", "null"]},
              "locator": {"type": "string", "minLength": 1}
            }
          }
        },
        "equations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "page", "raw_text", "latex", "number", "locator"],
            "properties": {
              "id": {"type": "string", "pattern": "^E[0-9]+$"},
              "page": {"type": ["integer", "null"]},
              "raw_text": {"type": "string"},
              "latex": {"type": ["string", "null"]},
              "number": {"type": "string"},
              "locator": {"type": "string", "minLength": 1}
            }
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "raw", "doi", "year"],
            "properties": {
              "id": {"type": "string", "pattern": "^R[0-9]+$"},
              "raw": {"type": "string"},
              "doi": {"type": "string"},
              "year": {"type": "string"},
              "title": {"type": "string"},
              "authors": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "headers_footers": {"type": "array"},
        "engine": {"type": "string"},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "report": {
      "type": "object",
      "required": ["case_id", "source_path", "page_count", "readable_pages",
                   "ocr_pages", "empty_pages", "sections", "paragraphs",
                   "tables", "figures", "equations", "references"],
      "properties": {
        "case_id": {"type": "string"},
        "source_path": {"type": "string"},
        "page_count": {"type": "integer", "minimum": 0},
        "readable_pages": {"type": "integer", "minimum": 0},
        "ocr_pages": {"type": "array", "items": {"type": "integer"}},
        "empty_pages": {"type": "array", "items": {"type": "integer"}},
        "sections": {"type": "integer", "minimum": 0},
        "paragraphs": {"type": "integer", "minimum": 0},
        "tables": {"type": "integer", "minimum": 0},
        "figures": {"type": "integer", "minimum": 0},
        "equations": {"type": "integer", "minimum": 0},
        "references": {"type": "integer", "minimum": 0},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}

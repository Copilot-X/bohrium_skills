{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Polishing glossary",
  "type": "object",
  "required": ["terms"],
  "properties": {
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target"],
        "properties": {
          "source": {"type": "string"},
          "target": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    }
  }
}

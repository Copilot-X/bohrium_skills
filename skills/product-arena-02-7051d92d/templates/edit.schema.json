{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Minimal-edit plan",
  "type": "object",
  "required": ["case_id", "edits"],
  "properties": {
    "case_id": {"type": "string"},
    "genre": {"type": "string"},
    "edits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "segment_id", "before", "after", "type", "reason"],
        "properties": {
          "id": {"type": "string"},
          "segment_id": {"type": "string", "pattern": "^P[0-9]{3}$"},
          "sentence_id": {"type": "string"},
          "before": {"type": "string", "minLength": 1},
          "after": {"type": "string"},
          "type": {"enum": ["grammar", "term", "register", "clarity", "cohesion", "typography"]},
          "reason": {"type": "string", "minLength": 3},
          "preserve": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "科研数据库查询与分析 work file",
  "type": "object",
  "required": [
    "case_id",
    "mode",
    "summary",
    "query",
    "sql_sha256",
    "snapshot",
    "schema_mapping",
    "row_count_check",
    "empty_result",
    "permissions",
    "results",
    "evidence"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1,
      "description": "必须与 /input/case.json 的 case_id 一致"
    },
    "mode": {
      "const": "database-query"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "一句话说明实际执行的查询与主要结果"
    },
    "analysis": {
      "type": "object",
      "properties": {
        "question": {"type": "string"},
        "method": {"type": "string"},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "steps": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["question", "method"]
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "description": "实际执行的单条只读 SQL；必须与 output/query.sql 一致"
    },
    "sql_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot": {
      "type": "object",
      "required": ["path", "sha256", "bytes", "read_only"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0},
        "sqlite_version": {"type": "string"},
        "read_only": {"const": true},
        "tables": {"type": "object"}
      }
    },
    "schema_mapping": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["dictionary_field", "exists_in_schema"],
        "properties": {
          "dictionary_field": {"type": "string"},
          "dictionary_description": {"type": "string"},
          "source": {"type": "string"},
          "locator": {"type": "string"},
          "quote": {"type": "string"},
          "schema_table": {"type": "string"},
          "schema_column": {"type": "string"},
          "exists_in_schema": {"type": "boolean"},
          "appears_in_query": {"type": "boolean"},
          "appears_in_result": {"type": "boolean"}
        }
      }
    },
    "row_count_check": {
      "type": "object",
      "required": ["actual", "ok"],
      "properties": {
        "expected": {"type": ["integer", "null"]},
        "actual": {"type": "integer", "minimum": 0},
        "ok": {"type": "boolean"},
        "source": {"type": "string"}
      }
    },
    "empty_result": {
      "type": "object",
      "required": ["is_empty", "statement"],
      "properties": {
        "is_empty": {"type": "boolean"},
        "missing_groups": {"type": "array", "items": {"type": "string"}},
        "coverage_checks": {"type": "array", "items": {"type": "object"}},
        "statement": {"type": "string", "minLength": 1}
      }
    },
    "permissions": {
      "type": "object",
      "required": ["status", "write_allowed"],
      "properties": {
        "status": {"const": "read_only"},
        "mode": {"type": "string"},
        "write_allowed": {"const": false},
        "notes": {"type": "string"}
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "metric", "value", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "metric": {"type": "string"},
          "value": {"type": ["number", "string", "boolean", "object", "array"]},
          "unit": {"type": "string"},
          "n": {"type": "integer"},
          "evidence": {
            "type": "object",
            "required": ["path", "locator", "quote"],
            "properties": {
              "path": {"type": "string"},
              "locator": {"type": "string"},
              "quote": {"type": "string"}
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "locator", "quote"],
        "properties": {
          "path": {"type": "string"},
          "locator": {"type": "string", "pattern": "^(L[0-9]+|P[0-9]+|\\$.*)$"},
          "quote": {"type": "string", "minLength": 1}
        }
      }
    },
    "join_checks": {
      "type": "array",
      "items": {"type": "object"}
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "reason"],
        "properties": {
          "item": {"type": "string"},
          "reason": {"type": "string"},
          "impact": {"type": "string"},
          "action": {"type": "string"}
        }
      }
    },
    "sql_text": {"type": "string"},
    "result_table": {"type": "string"},
    "field_mapping": {"type": "object"},
    "empty_result_handling": {"type": "object"},
    "snapshot_version": {"type": "object"}
  }
}

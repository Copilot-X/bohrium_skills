{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-bound literature graph (work/graph.json)",
  "type": "object",
  "required": ["nodes", "edges", "merges", "queries"],
  "properties": {
    "case_id": {"type": "string"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "type", "source_ids", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^N[0-9]+$"},
          "label": {"type": "string", "minLength": 1},
          "type": {
            "enum": ["researcher", "material", "method", "task", "metric",
                     "finding", "concept", "dataset", "condition", "organism",
                     "model", "other"]
          },
          "aliases": {"type": "array", "items": {"type": "string"}},
          "source_ids": {
            "type": "array", "minItems": 1, "items": {"type": "string"}
          },
          "evidence": {
            "type": "array", "minItems": 1,
            "items": {"$ref": "#/$defs/evidence"}
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "target", "type", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^E[0-9]+$"},
          "source": {"type": "string"},
          "target": {"type": "string"},
          "type": {
            "enum": ["uses", "compares", "outperforms", "underperforms",
                     "supports", "contradicts", "measured_by", "part_of",
                     "is_a", "predicts", "causes", "associated_with",
                     "reports", "evaluated_on", "trained_on", "derived_from",
                     "related_to", "enhances", "reduces", "modulates",
                     "interacts_with", "co_occurs_with", "has_part",
                     "has_property", "measured_as", "expresses", "encodes",
                     "treats", "prevents", "induces", "represses", "other"]
          },
          "direction": {"enum": ["forward", "reverse", "undirected"]},
          "conditions": {"type": "array", "items": {"type": "string"}},
          "evidence": {
            "type": "array", "minItems": 1,
            "items": {"$ref": "#/$defs/evidence"}
          },
          "strength": {"enum": ["direct", "indirect"]}
        }
      }
    },
    "merges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_ids", "decision", "basis"],
        "properties": {
          "candidate_ids": {
            "type": "array", "minItems": 2, "items": {"type": "string"}
          },
          "decision": {"enum": ["merge", "keep_separate"]},
          "basis": {"type": "string", "minLength": 3},
          "conflict": {"type": "string"}
        }
      }
    },
    "queries": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "question", "answer"],
        "properties": {
          "id": {"type": "string", "pattern": "^Q[0-9]+$"},
          "question": {"type": "string", "minLength": 3},
          "start_node_ids": {"type": "array", "items": {"type": "string"}},
          "edge_types": {"type": "array", "items": {"type": "string"}},
          "result_node_ids": {"type": "array", "items": {"type": "string"}},
          "answer": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array", "items": {"$ref": "#/$defs/evidence"}
          },
          "uncertain": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["source_id", "paragraph_id", "quote"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "paragraph_id": {"type": "string", "minLength": 1},
        "quote": {"type": "string", "minLength": 1},
        "locator": {
          "type": "string",
          "description": "可选；只允许 source_id + paragraph_id，禁止写 PDF 页码"
        }
      }
    }
  }
}

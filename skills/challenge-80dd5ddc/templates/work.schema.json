{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "科研知识库问答 work file",
  "type": "object",
  "required": [
    "case_id",
    "summary",
    "answers",
    "evidence"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "description": "task-specific field"
    },
    "mode": {
      "type": "string",
      "description": "task-specific field"
    },
    "summary": {
      "type": "string",
      "description": "task-specific field"
    },
    "items": {
      "type": "array",
      "description": "文件/记录条目：path、kind、metadata、hash、status、evidence",
      "items": {
        "type": "object"
      }
    },
    "operations": {
      "type": "array",
      "description": "索引/移动/分类/批注等操作及结果",
      "items": {
        "type": "object"
      }
    },
    "findings": {
      "type": "array",
      "description": "检索/问答/批注结论及证据",
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array",
      "description": "path+locator+quote 的逐字证据",
      "items": {
        "type": "object"
      }
    },
    "uncertainties": {
      "type": "array",
      "description": "权限、损坏、跳过、冲突",
      "items": {
        "type": "object"
      }
    },
    "answers": {
      "type": "array",
      "description": "task-specific field required by this sub-challenge",
      "items": {
        "type": "object"
      }
    },
    "retrieval": {
      "type": "array",
      "description": "task-specific field required by this sub-challenge",
      "items": {
        "type": "object"
      }
    }
  }
}

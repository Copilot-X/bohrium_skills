{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "实验参数优化建议 work file",
  "type": "object",
  "required": [
    "case_id",
    "summary",
    "recommendations",
    "parameters",
    "evidence",
    "validation_experiment"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "description": "task-specific field"
    },
    "mode": {
      "type": "string",
      "description": "task-specific field"
    },
    "summary": {
      "type": "string",
      "description": "task-specific field"
    },
    "hypothesis": {
      "type": "string",
      "description": "可检验假设"
    },
    "variables": {
      "type": "object",
      "description": "自变量、因变量、对照"
    },
    "steps": {
      "type": "array",
      "description": "可执行步骤、参数、时长与材料",
      "items": {
        "type": "object"
      }
    },
    "parameters": {
      "type": "array",
      "description": "参数值、单位与依据",
      "items": {
        "type": "object"
      }
    },
    "risks": {
      "type": "array",
      "description": "风险、影响与处置",
      "items": {
        "type": "object"
      }
    },
    "confirmation_items": {
      "type": "array",
      "description": "需要作者确认的设备/安全/伦理条件",
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array",
      "description": "path+locator+quote 的逐字证据",
      "items": {
        "type": "object"
      }
    },
    "uncertainties": {
      "type": "array",
      "description": "未确认、冲突、缺口",
      "items": {
        "type": "object"
      }
    },
    "parameter_space": {
      "type": "array",
      "description": "task-specific field required by this sub-challenge",
      "items": {
        "type": "object"
      }
    },
    "constraints": {
      "type": "array",
      "description": "task-specific field required by this sub-challenge",
      "items": {
        "type": "object"
      }
    },
    "history": {
      "type": "array",
      "description": "task-specific field required by this sub-challenge",
      "items": {
        "type": "object"
      }
    },
    "recommendations": {
      "type": "array",
      "description": "task-specific field required by this sub-challenge",
      "items": {
        "type": "object"
      }
    },
    "validation_experiment": {
      "type": "object",
      "description": "验证步骤、判读标准、停止条件与预算"
    },
    "parameter_analysis": {
      "type": "object",
      "description": "指向 output/parameter-analysis.json：脚本状态、数据质量、敏感性、约束与 not_computable",
      "properties": {
        "script": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "not_computable": {
          "type": "array",
          "items": {}
        }
      }
    },
    "objective": {
      "type": "string",
      "description": "目标响应列与方向（如 yield_pct:max）"
    },
    "sensitivity_summary": {
      "type": "object",
      "description": "参数-响应敏感性/趋势摘要，须注明描述性口径与 n"
    },
    "tradeoffs": {
      "type": "object",
      "description": "响应指标之间的权衡与非可行最优点说明"
    }
  }
}

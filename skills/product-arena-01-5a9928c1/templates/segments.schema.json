{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Translation segments (work/segments.json)",
  "description": "Generated by fam_translate.prepare. P IDs and line ranges are the alignment contract; do not merge, split or reorder.",
  "type": "object",
  "required": ["case_id", "direction", "segments"],
  "properties": {
    "case_id": {"type": "string"},
    "direction": {"type": "string", "examples": ["zh->en", "en->zh"]},
    "source_language": {"type": "string", "enum": ["zh", "en"]},
    "target_language": {"type": "string", "enum": ["zh", "en"]},
    "source_path": {"type": "string"},
    "source_kind": {"type": "string"},
    "source_sha256": {"type": "string"},
    "source_chars": {"type": "integer"},
    "segment_count": {"type": "integer"},
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "locator"],
        "properties": {
          "id": {"type": "string", "pattern": "^P[0-9]{3}$"},
          "text": {"type": "string"},
          "locator": {"type": "string", "description": "e.g. paper.md P004"},
          "line_start": {"type": "integer"},
          "line_end": {"type": "integer"},
          "page": {"type": ["integer", "null"]},
          "kind": {"type": "string", "enum": ["body", "heading", "formula", "table", "list"]},
          "sentences": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {"type": "string"},
                "sentence_id": {"type": "string"},
                "text": {"type": "string"},
                "locator": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}

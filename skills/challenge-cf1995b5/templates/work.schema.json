{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "实验方案生成与优化 work file",
  "type": "object",
  "required": [
    "case_id",
    "summary",
    "steps",
    "parameters",
    "evidence"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "description": "task-specific field"
    },
    "mode": {
      "type": "string",
      "description": "task-specific field"
    },
    "summary": {
      "type": "string",
      "description": "task-specific field"
    },
    "hypothesis": {
      "type": "string",
      "description": "task-specific field required by this sub-challenge"
    },
    "variables": {
      "type": "object",
      "description": "task-specific field required by this sub-challenge"
    },
    "steps": {
      "type": "array",
      "description": "task-specific field required by this sub-challenge",
      "items": {
        "type": "object"
      }
    },
    "parameters": {
      "type": "array",
      "description": "task-specific field required by this sub-challenge",
      "items": {
        "type": "object"
      }
    },
    "risks": {
      "type": "array",
      "description": "风险、影响与处置",
      "items": {
        "type": "object"
      }
    },
    "confirmation_items": {
      "type": "array",
      "description": "需要作者确认的设备/安全/伦理条件",
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array",
      "description": "path+locator+quote 的逐字证据",
      "items": {
        "type": "object"
      }
    },
    "uncertainties": {
      "type": "array",
      "description": "未确认、冲突、缺口",
      "items": {
        "type": "object"
      }
    },
    "readout": {
      "type": "object",
      "description": "task-specific field required by this sub-challenge"
    },
    "resources": {
      "type": "object",
      "description": "task-specific field required by this sub-challenge"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "研究前沿与趋势分析 work file",
  "type": "object",
  "required": [
    "case_id",
    "summary",
    "time_window",
    "year_counts",
    "topic_counts",
    "representative_rule",
    "findings",
    "evidence"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "description": "task-specific field"
    },
    "mode": {
      "type": "string",
      "description": "task-specific field"
    },
    "summary": {
      "type": "string",
      "description": "task-specific field"
    },
    "question": {
      "type": "string",
      "description": "研究问题与范围"
    },
    "findings": {
      "type": "array",
      "description": "结论、来源与证据组",
      "items": {
        "type": "object"
      }
    },
    "references": {
      "type": "array",
      "description": "引用条目与标识符",
      "items": {
        "type": "object"
      }
    },
    "gap_analysis": {
      "type": "array",
      "description": "研究空白及其证据基础",
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array",
      "description": "path+locator+quote 的逐字证据",
      "items": {
        "type": "object"
      }
    },
    "uncertainties": {
      "type": "array",
      "description": "冲突、空白、未覆盖范围",
      "items": {
        "type": "object"
      }
    },
    "time_window": {
      "type": "object",
      "description": "task-specific field required by this sub-challenge"
    },
    "year_counts": {
      "type": "array",
      "description": "task-specific field required by this sub-challenge",
      "items": {
        "type": "object"
      }
    },
    "topic_counts": {
      "type": "array",
      "description": "task-specific field required by this sub-challenge",
      "items": {
        "type": "object"
      }
    },
    "representative_rule": {
      "type": "string",
      "description": "task-specific field required by this sub-challenge"
    },
    "representatives": {
      "type": "array",
      "description": "task-specific field required by this sub-challenge",
      "items": {
        "type": "object"
      }
    }
  }
}

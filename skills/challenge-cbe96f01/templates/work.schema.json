{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "引用与事实核验 work file",
  "type": "object",
  "required": [
    "case_id",
    "summary",
    "claim_source_matrix",
    "source_status",
    "findings",
    "evidence"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "description": "task-specific field"
    },
    "mode": {
      "type": "string",
      "description": "task-specific field"
    },
    "summary": {
      "type": "string",
      "description": "task-specific field"
    },
    "findings": {
      "type": "array",
      "description": "逐条问题：location、issue、severity、comment、evidence",
      "items": {
        "type": "object"
      }
    },
    "checks": {
      "type": "array",
      "description": "检查项与 pass/fail/not_checked",
      "items": {
        "type": "object"
      }
    },
    "verdict": {
      "type": "string",
      "description": "总体判断及边界"
    },
    "evidence": {
      "type": "array",
      "description": "path+locator+quote 的逐字证据",
      "items": {
        "type": "object"
      }
    },
    "uncertainties": {
      "type": "array",
      "description": "无法判断、材料不足、待复核",
      "items": {
        "type": "object"
      }
    },
    "claim_source_matrix": {
      "type": "array",
      "description": "task-specific field required by this sub-challenge",
      "items": {
        "type": "object"
      }
    },
    "source_status": {
      "type": "array",
      "description": "task-specific field required by this sub-challenge",
      "items": {
        "type": "object"
      }
    }
  }
}

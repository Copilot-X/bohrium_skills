{
  "case_id": "<case_id，与 /input/case.json 一致>",
  "talk": {
    "occasion": "group meeting",
    "audience": "<听众画像：人数、专业背景、方法熟悉度>",
    "audience_level": "expert",
    "listener_question": "<听众坐下时最想问的一句话>",
    "desired_outcome": "<讲完后听众应能复述/相信/决定什么>",
    "language": "zh",
    "total_min": 15,
    "qa_min": 4,
    "buffer_min": 1,
    "throughline": "<一句听众结果句：条件 + 判断 + 边界>",
    "must_cover": ["研究问题", "方法", "关键结果", "局限"],
    "nice_to_have": ["文献对比", "实现细节"],
    "forbidden": ["未发表数据", "未经证实的因果表述"]
  },
  "budget": {
    "slide_budget": 12,
    "backup_slides": 2,
    "time_tolerance": 0.15,
    "deck_required": true
  },
  "sections": [
    {
      "id": "S1",
      "name": "开场与问题",
      "minutes": 1.5,
      "purpose": "让听众在意这个缺口，并记住唯一研究问题",
      "slides": [1, 2, 3]
    },
    {
      "id": "S2",
      "name": "方法与设计",
      "minutes": 3.0,
      "purpose": "说明为什么这样答，建立方法可信度",
      "slides": [4, 5, 6]
    },
    {
      "id": "S3",
      "name": "关键结果",
      "minutes": 3.0,
      "purpose": "用逐层加码的证据支撑主结论",
      "slides": [7, 8, 9]
    },
    {
      "id": "S4",
      "name": "边界与结论",
      "minutes": 2.5,
      "purpose": "主动说明边界，给出听众可带走的判断",
      "slides": [10, 11, 12]
    }
  ],
